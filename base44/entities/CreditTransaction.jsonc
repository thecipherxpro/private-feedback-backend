{"name":"CreditTransaction","type":"object","properties":{"user_id":{"type":"string"},"type":{"type":"string","enum":["FREE_GRANT","PURCHASE","MESSAGE_DEBIT","REFUND","ADMIN_ADJUSTMENT"]},"quantity":{"type":"number"},"balance_after":{"type":"number"},"payment_id":{"type":"string"},"message_id":{"type":"string"}},"required":["user_id","type","quantity","balance_after"],"rls":{"create":{"user_condition":{"role":"admin"}},"read":{"$or":[{"data.user_id":"{{user.id}}"},{"user_condition":{"role":"admin"}}]},"update":{"user_condition":{"role":"admin"}},"delete":{"user_condition":{"role":"admin"}}}}